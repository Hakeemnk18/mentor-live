PORT=4005
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/mentor-live

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# JWT secrets - use long random strings
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Refresh token rate limiting
REFRESH_RATE_LIMIT_WINDOW=60000
REFRESH_RATE_LIMIT_MAX=5

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS + WhatsApp booking notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
MAX_ATTEMPTS=5
